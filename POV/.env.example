# ============================================================================
# POV deployment bundle environment
# Copy to .env and adjust before running install.sh.
# ============================================================================

STAYIN_VERSION=1.0.0
TZ=Asia/Jakarta
LOG_LEVEL=info

# --- Databases (two separate database objects) ------------------------------
POSTGRES_USER=stayin
POSTGRES_PASSWORD=stayin-local-secret
POSTGRES_MAIN_DB=stayin_main
POSTGRES_LOCAL_DB=stayin_local
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Shared secret for POST /api/v1/nodes/inventory. Leave empty to disable.
NODE_API_KEY=

# --- Auth -------------------------------------------------------------------
JWT_SECRET=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://192.168.1.10,http://localhost

# --- Bootstrap accounts (created only when the user table is empty) ---------
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@stayin.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=Owner#2026
BOOTSTRAP_SUPER_ADMIN_NAME=StayIn Owner
BOOTSTRAP_TENANT_ADMIN_EMAIL=admin@dlu-alfateve.local
BOOTSTRAP_TENANT_ADMIN_PASSWORD=Mitra#2026
BOOTSTRAP_TENANT_ADMIN_NAME=DLU Alfateve Admin

# --- Tenant -----------------------------------------------------------------
TENANT_SLUG=dlu-alfateve
TENANT_NAME=DLU X ALFATEVE
NODE_CODE=DLU-NODE-01

# --- Storage ----------------------------------------------------------------
# On the mini PC point this at the flashdisk mount, for example /media/dlu-usb
MEDIA_HOST_DIR=./storage
SCAN_ON_START=true
SCAN_INTERVAL_SECONDS=300
SCAN_COMPUTE_HASH=true
SCAN_HASH_WORKERS=2
SCAN_MAX_DEPTH=6

# --- Streaming --------------------------------------------------------------
STREAM_BUFFER_BYTES=65536
STREAM_MAX_OPEN_FILES=256
STREAM_CACHE_SECONDS=86400

# --- WebSocket --------------------------------------------------------------
WS_PING_INTERVAL_SECONDS=25
WS_WRITE_TIMEOUT_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=120

# --- Ports ------------------------------------------------------------------
HTTP_PORT=80
BACKEND_PORT=8080
WEB_PORT=3000

# --- CMS --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://backend:8080/api/v1
NEXT_PUBLIC_DEFAULT_TENANT=dlu-alfateve

# --- Optional cloud pull ----------------------------------------------------
CLOUD_BASE_URL=
CLOUD_API_KEY=
